{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "operation": {
      "enum": [
        "reference",
        "model-review",
        "md-review",
        "template-build",
        "export",
        "word-export",
        "visual-receipt",
        "package"
      ]
    },
    "engine_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "input_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "variant",
        "font_profile",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "font_profile": {
          "type": "string"
        },
        "year": {
          "type": ["integer", "null"]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "manuscript",
              "metadata",
              "image",
              "bibliography",
              "evidence",
              "approvals",
              "font",
              "reference",
              "visual_receipt",
              "composition"
            ]
          }
        }
      }
    },
    "manuscript": {
      "type": "string"
    },
    "metadata": {
      "type": "string"
    },
    "approval_file": {
      "type": "string"
    },
    "model_evidence": {
      "type": "string"
    },
    "reference_evidence": {
      "type": "string"
    },
    "bibliography": {
      "type": "string"
    },
    "visual_receipt": {
      "type": "string"
    },
    "consistency_registry": {
      "type": "string"
    },
    "document_kind": {
      "enum": [
        "model",
        "paper",
        "format"
      ]
    },
    "expected_equations": {
      "type": "integer",
      "minimum": 0
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "md_content",
        "presentation",
        "export"
      ],
      "properties": {
        "md_content": {
          "type": "string"
        },
        "presentation": {
          "type": "string"
        },
        "export": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "docx",
          "latex",
          "docx-proof-pdf",
          "latex-pdf",
          "previews"
        ]
      }
    },
    "artifact_run": {
      "type": "string"
    },
    "artifact_name": {
      "enum": [
        "document-task",
        "skill-delivery",
        "review-delivery",
        "template-matrix"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "export"
          }
        }
      },
      "then": {
        "required": [
          "manuscript",
          "template",
          "approval_file",
          "approvals",
          "engine_commit",
          "outputs"
        ]
      }
    }
  ]
}
